  <!-- SOLD MODAL -->
  <div id="sold-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-3 md:p-4">
    <div class="bg-slate-900 border border-emerald-500/20 rounded-2xl p-5 md:p-6 max-w-sm w-full shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center">
        <h3 class="text-base md:text-lg font-bold text-white" data-i18n="soldTitle">Pixel bereits gesichert</h3>
        <button onclick="closeSoldModal()" class="text-slate-400 hover:text-white text-2xl">&times;</button>
      </div>
      <div class="mt-3 md:mt-4 space-y-2 text-xs md:text-sm">
        <div id="sold-place" class="text-emerald-400 font-semibold"></div>
        <div id="sold-owner" class="text-slate-300"></div>
        <div id="sold-id" class="font-mono text-xs text-slate-500"></div>
        <div id="sold-message" class="hidden mt-3 p-3 rounded-xl bg-slate-950/70 border border-slate-800 text-slate-300 text-xs md:text-sm whitespace-pre-wrap"></div>
      </div>
      <button onclick="closeSoldModal()" class="mt-4 md:mt-5 w-full border border-slate-700 hover:border-emerald-500/50 py-2 md:py-2.5 rounded-xl text-xs md:text-sm min-h-[44px]">
        <span data-i18n="otherPlace">Andere Stelle auswählen</span>
      </button>
    </div>
  </div>

  <script>
    lucide.createIcons();

    const COLS = 40000;
    const ROWS = 25000;
    const TOTAL = 1000000000;

    const map = L.map('map', {
      zoomControl: false,
      worldCopyJump: false,
      maxBounds: [[-90, -180], [90, 180]],
      maxBoundsViscosity: 1,
      minZoom: 2
    }).setView([25, 10], 2.3);

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 19,
      maxNativeZoom: 19,
      noWrap: true,
      updateWhenIdle: true,
      keepBuffer: 2
    }).addTo(map);

    let currentMarker = null;
    let soldLayer = L.layerGroup().addTo(map);
    let loadedSoldIds = new Set();
    let lastBoundsKey = '';
    let loadingSold = false;

    function geoToId(lat, lon) {
      const clat = Math.max(-90, Math.min(90, Number(lat)));
      let x = ((Number(lon) + 180) / 360);
      x = ((x % 1) + 1) % 1;
      const col = Math.min(COLS - 1, Math.floor(x * COLS));
      const row = Math.min(ROWS - 1, Math.max(0, Math.floor((90 - clat) / 180 * ROWS)));
      return row * COLS + col;
    }

    function makeIcon(className) {
      return L.divIcon({
        className: '',
        html: '<div class="' + className + '"></div>',
        iconSize: className === 'selected-pixel' ? [20,20] : [16,16],
        iconAnchor: className === 'selected-pixel' ? [10,10] : [8,8],
        popupAnchor: [0,-8]
      });
    }

    async function loadSoldPixels() {
      if (loadingSold) return;
      const b = map.getBounds();
      const minLat = Math.max(-90, b.getSouth());
      const maxLat = Math.min(90, b.getNorth());
      const minLon = Math.max(-180, b.getWest());
      const maxLon = Math.min(180, b.getEast());

      const key = [minLat.toFixed(3), maxLat.toFixed(3), minLon.toFixed(3), maxLon.toFixed(3), map.getZoom()].join('|');
      if (key === lastBoundsKey) return;
      lastBoundsKey = key;
      loadingSold = true;

      try {
        const limit = window.innerWidth < 768 ? 1200 : 5000;
        const url = '/api/pixels?minLat=' + encodeURIComponent(minLat)
          + '&maxLat=' + encodeURIComponent(maxLat)
          + '&minLon=' + encodeURIComponent(minLon)
          + '&maxLon=' + encodeURIComponent(maxLon)
          + '&limit=' + limit;

        const res = await fetch(url);
        if (!res.ok) throw new Error('Pixel API ' + res.status);
        const data = await res.json();
        const rows = Array.isArray(data.pixels) ? data.pixels : [];

        rows.forEach(p => {
          const id = Number(p.pixel_id);
          if (!Number.isInteger(id) || loadedSoldIds.has(id)) return;
          loadedSoldIds.add(id);

          const marker = L.marker([Number(p.lat), Number(p.lon)], {
            icon: makeIcon('sold-pixel'),
            zIndexOffset: 500
          });

          const title = p.display_name ? escapeHtml(p.display_name) : 'Gesicherter Pixel';
          const website = p.website ? '<div class="text-xs mt-1">' + escapeHtml(p.website) + '</div>' : '';
          const message = p.message
            ? '<div style="font-size:12px;color:#cbd5e1;margin-top:8px;padding-top:8px;border-top:1px solid rgba(51,65,85,.7);white-space:pre-wrap">' + escapeHtml(p.message) + '</div>'
            : '';

          marker.bindPopup(
            '<div class="pixel-popup px-1">' +
              '<div style="font-weight:700;color:#6ee7b7">' + title + '</div>' +
              '<div style="font-size:11px;color:#94a3b8;margin-top:3px">Pixel #' + id + '</div>' +
              website +
              message +
            '</div>',
            { className: 'pixel-popup' }
          );

          marker.on('click', async function(ev) {
            L.DomEvent.stopPropagation(ev);

            document.getElementById('checkout-modal').classList.add('hidden');
            document.getElementById('checkout-modal').style.display = 'none';

            document.getElementById('sold-place').textContent = 'Lade Ort ...';
            document.getElementById('sold-owner').textContent = title;
            document.getElementById('sold-id').textContent = 'Pixel #' + id;
            document.getElementById('sold-modal').classList.remove('hidden');
            document.getElementById('sold-modal').style.display = 'flex';

            try {
              const check = await fetch('/api/pixel?id=' + encodeURIComponent(id));
              const info = await check.json();
              const place = info.place_name || 'Geografischer Pixel';
              document.getElementById('sold-place').textContent = place;
              document.getElementById('sold-owner').textContent =
                info.pixel && info.pixel.display_name
                  ? 'Gesichert von: ' + info.pixel.display_name
                  : 'Dieser Pixel wurde bereits gesichert.';
            } catch (_) {
              document.getElementById('sold-place').textContent = 'Geografischer Pixel';
            }
          });

          marker.addTo(soldLayer);
        });

        const stats = await fetch('/api/stats').then(r => r.ok ? r.json() : null).catch(() => null);
        if (stats) document.getElementById('sold-count').textContent = Number(stats.sold || 0).toLocaleString('de-DE');
      } catch (err) {
        console.error('Sold pixels could not be loaded:', err);
      } finally {
        loadingSold = false;
      }
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
      }[ch]));
    }

    map.on('moveend', loadSoldPixels);

    map.on('click', async function(e) {
      const lat = e.latlng.lat;
      const lon = e.latlng.lng;
      const pixelId = geoToId(lat, lon);

      document.getElementById('coords-display').textContent =
        'Lat: ' + lat.toFixed(4) + '°, Lon: ' + lon.toFixed(4) + '°';
      document.getElementById('selected-info').textContent = (T[window.PM_LANG || 'en']?.check || 'Checking pixel #') + pixelId + ' ...';
      document.getElementById('selected-place').textContent = '';

      if (currentMarker) map.removeLayer(currentMarker);
      currentMarker = L.marker([lat, lon], {
        icon: makeIcon('selected-pixel'),
        zIndexOffset: 1000
      }).addTo(map);

      try {
        const res = await fetch('/api/pixel?id=' + encodeURIComponent(pixelId));
        const data = await res.json();

        if (!res.ok) throw new Error(data.error || ('Pixel API ' + res.status));

        const sold = data.pixel;
        const place = data.place_name || '';
        document.getElementById('selected-place').textContent =
          place ? (T[window.PM_LANG || 'en']?.place || 'Ort: ') + place : (T[window.PM_LANG || 'en']?.placeUnknown || 'Ort nicht ermittelt');

        if (sold) {
          document.getElementById('selected-info').textContent = 'Pixel #' + pixelId + ' · ' + (T[window.PM_LANG || 'en']?.saved || 'gesichert');
          document.getElementById('sold-place').textContent = place || 'Gesicherter Ort';
          document.getElementById('sold-owner').textContent = sold.display_name
            ? 'Gesichert von: ' + sold.display_name
            : 'Dieser Pixel wurde bereits gesichert.';
          document.getElementById('sold-id').textContent = 'Pixel #' + pixelId;

          const soldMessageEl = document.getElementById('sold-message');
          if (sold.message) {
            soldMessageEl.textContent = '„' + sold.message + '“';
            soldMessageEl.classList.remove('hidden');
          } else {
            soldMessageEl.textContent = '';
            soldMessageEl.classList.add('hidden');
          }

          document.getElementById('sold-modal').classList.remove('hidden');
          return;
        }

        document.getElementById('selected-info').textContent = 'Pixel #' + pixelId + ' · ' + (T[window.PM_LANG || 'en']?.available || 'verfügbar');
        openModal(pixelId, lat, lon, place);
      } catch (err) {
        console.error(err);
        document.getElementById('selected-info').textContent = 'Pixel #' + pixelId;
        document.getElementById('checkout-error').textContent =
          'Der Pixel konnte gerade nicht geprüft werden. Bitte erneut versuchen.';
        document.getElementById('checkout-error').classList.remove('hidden');
      }
    });

    function openModal(pixelId, lat, lon, place) {
      const modal = document.getElementById('checkout-modal');
      const btn = document.getElementById('submit-btn');

      document.getElementById('pixel_id_input').value = pixelId;
      document.getElementById('pixel_id_display').value =
        place || (T[window.PM_LANG || 'en']?.loading || 'Ort wird ermittelt ...');
      document.getElementById('modal-place').textContent =
        place ? (T[window.PM_LANG || 'en']?.selectedPlace || 'Ort ausgewählt') : (T[window.PM_LANG || 'en']?.loading || 'Ort wird ermittelt ...');

      document.getElementById('checkout-error').classList.add('hidden');
      btn.disabled = false;
      btn.textContent = T[window.PM_LANG || 'en']?.stripeButton || 'Weiter zu Stripe · 1,00 €';

      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      modal.style.visibility = 'visible';
      modal.style.opacity = '1';

      setTimeout(() => {
        const name = document.getElementById('display_name');
        if (name) name.focus();
      }, 50);
    }

    function closeModal() {
      const modal = document.getElementById('checkout-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
      modal.style.visibility = 'hidden';
      modal.style.opacity = '0';
    }

    function closeSoldModal() {
      const modal = document.getElementById('sold-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
    }

    function focusForPurchase() {
      map.setView([51.1657, 10.4515], 5, { animate: true });
