function applyLanguage(lang) {
      lang = LANGS[lang] ? lang : 'en';
      const t = T[lang];
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (t[key] !== undefined) el.innerHTML = t[key];
      });
      document.getElementById('language-name').textContent = LANGS[lang].name;
      document.getElementById('language-flag').textContent = LANGS[lang].flag;
      localStorage.setItem('pixelmaps-language', lang);
      window.PM_LANG = lang;
      renderPrice();
    }

    function renderPrice() {
      const p = window.PM_PRICE;
      const btn = document.getElementById('submit-btn');
      if (!p || !p.display || !btn) return;
      const span = btn.querySelector('span[data-i18n="stripeButton"]');
      const base = (T[window.PM_LANG || 'en']?.stripeButton || '').split('·').map(s => s.trim()).filter(Boolean);
      if (span && base.length > 1) {
        span.textContent = base[0] + ' · ' + p.display;
      }
    }

    async function refreshPrice() {
      try {
        const cc = window.PM_CC || '';
        const r = await fetch('/api/price' + (cc ? '?cc=' + encodeURIComponent(cc) : ''), { cache: 'no-store' });
        if (!r.ok) return;
        window.PM_PRICE = await r.json();
        renderPrice();
      } catch (_) {}
    }

    async function detectCountryLanguage() {
      const saved = localStorage.getItem('pixelmaps-language');
      if (saved && LANGS[saved]) return saved;

      try {
        const r = await fetch('/cdn-cgi/trace', { cache: 'no-store' });
        const text = await r.text();
        const m = text.match(/^loc=([A-Z]{2})$/m);
        const cc = m ? m[1] : '';
        window.PM_CC = cc;
        const countryMap = {
          DE:'de', AT:'de', CH:'de', LI:'de',
          US:'en', GB:'en', CA:'en', AU:'en', NZ:'en', IE:'en',
          FR:'fr', BE:'fr', LU:'fr',
          ES:'es', MX:'es', AR:'es', CL:'es', CO:'es',
          IT:'it', NL:'nl', PL:'pl', PT:'pt', BR:'pt'
        };
        if (countryMap[cc]) return countryMap[cc];
      } catch (_) {}

      const browser = (navigator.language || 'en').slice(0,2).toLowerCase();
      return LANGS[browser] ? browser : 'en';
    }

    function handleReturn() {
      const qs = new URLSearchParams(location.search);
      const banner = document.getElementById('return-banner');

      if (qs.get('success') === '1') {
        history.replaceState({}, '', location.pathname);
        const pixelParam = Number(qs.get('pixel'));
        const lastPixelId = Number(localStorage.getItem('pixelmaps_last_purchase_pixel_id'));
        const pixelId = (Number.isInteger(pixelParam) && pixelParam >= 0)
          ? pixelParam
          : (Number.isInteger(lastPixelId) ? lastPixelId : null);
        const tok = qs.get('tok') || localStorage.getItem('pixelmaps_last_purchase_token') || '';

        if (pixelId !== null) {
          localStorage.setItem('pixelmaps_last_purchase_pixel_id', String(pixelId));
          if (tok) localStorage.setItem('pixelmaps_last_purchase_token', tok);
          const certUrl = '/api/certificate?id=' + encodeURIComponent(pixelId) + '&tok=' + encodeURIComponent(tok);
          if (banner) {
            banner.classList.remove('hidden');
            banner.innerHTML = '<div class="spinner"></div><span>Zahlung wird bestätigt — die Urkunde wird geladen…</span>';
          }
          let attempts = 0;
          const tryLoad = () => {
            attempts++;
            fetch(certUrl).then(r => {
              if (r.status === 200 || r.status === 403) {
                window.location.href = certUrl;
              } else if (attempts < 12) {
                setTimeout(tryLoad, 1500);
              } else {
                window.location.href = certUrl;
              }
            }).catch(() => {
              if (attempts < 12) setTimeout(tryLoad, 1500);
              else window.location.href = certUrl;
            });
          };
          setTimeout(tryLoad, 2000);
        } else if (banner) {
          banner.classList.remove('hidden');
          banner.innerHTML = '<span>Zahlung erhalten — vielen Dank!</span>';
        }
      } else if (qs.get('cancelled') === '1') {
        history.replaceState({}, '', location.pathname);
        if (banner) {
          banner.classList.remove('hidden');
          banner.innerHTML = '<span>Checkout abgebrochen. Dein Pixel ist noch verfügbar.</span>';
          setTimeout(() => banner.classList.add('hidden'), 6000);
        }
      }
    }

    const languageButton = document.getElementById('language-button');
    const languageMenu = document.getElementById('language-menu');
    languageButton.addEventListener('click', () => languageMenu.classList.toggle('hidden'));
    document.querySelectorAll('.language-option').forEach(btn => {
      btn.addEventListener('click', () => {
        applyLanguage(btn.dataset.lang);
        languageMenu.classList.add('hidden');
      });
    });
    document.addEventListener('click', e => {
      if (!languageButton.contains(e.target) && !languageMenu.contains(e.target)) languageMenu.classList.add('hidden');
    });

    const sidePanel = document.getElementById('side-panel');
    const panelToggle = document.getElementById('panel-toggle');
    const panelIcon = document.getElementById('panel-toggle-icon');
    if (sidePanel && panelToggle) {
      panelToggle.addEventListener('click', () => {
        const minimized = sidePanel.classList.toggle('minimized');
        if (panelIcon) {
          panelIcon.setAttribute('data-lucide', minimized ? 'chevron-down' : 'chevron-up');
          lucide.createIcons();
        }
      });
      if (window.innerWidth < 768 && !sidePanel.classList.contains('minimized')) {
        sidePanel.classList.add('minimized');
        if (panelIcon) {
          panelIcon.setAttribute('data-lucide', 'chevron-down');
        }
      }
    }

    detectCountryLanguage().then(lang => {
      applyLanguage(lang);
      refreshPrice();
    });
    loadSoldPixels();
    handleReturn();
