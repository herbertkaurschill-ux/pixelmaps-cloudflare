      <div class="w-7 h-7 md:w-8 md:h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/50 flex items-center justify-center"
           style="box-shadow:0 0 18px rgba(16,185,129,.35)">
        <i data-lucide="grid" class="w-4 h-4 md:w-5 md:h-5 text-emerald-400"></i>
