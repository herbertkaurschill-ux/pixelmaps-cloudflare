<!DOCTYPE html>
<html lang="de" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>PixelMaps — The Global Pixel Project</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    html, body { margin: 0; width: 100%; height: 100%; }
    #map { background: #050911; }
    .leaflet-container { background: #050911 !important; font-family: Inter, system-ui, sans-serif; }
    .leaflet-tile { filter: saturate(.72) brightness(.48) contrast(1.18); }
    .leaflet-control-attribution {
      background: rgba(2, 8, 18, .72) !important;
      color: #64748b !important;
      border-radius: 8px 0 0 0;
      font-size: 9px !important;
    }
    .leaflet-control-attribution a { color: #94a3b8 !important; }

    .sold-pixel {
      width: 12px;
      height: 12px;
      border-radius: 3px;
      background: #20f6a2;
      border: 2px solid rgba(190,255,231,.95);
      box-shadow:
        0 0 7px rgba(32,246,162,.95),
        0 0 18px rgba(32,246,162,.7),
        0 0 32px rgba(32,246,162,.35);
    }
    .selected-pixel {
      width: 16px;
      height: 16px;
      border-radius: 4px;
      background: #9affdc;
      border: 2px solid #ffffff;
      box-shadow:
        0 0 8px rgba(154,255,220,1),
        0 0 22px rgba(32,246,162,.95),
        0 0 44px rgba(32,246,162,.5);
    }
    .pixel-popup {
      background: rgba(5,12,24,.94);
      color: #e2e8f0;
      border: 1px solid rgba(52,211,153,.35);
      border-radius: 12px;
      box-shadow: 0 15px 40px rgba(0,0,0,.45);
    }
    .pixel-popup .leaflet-popup-content-wrapper,
    .pixel-popup .leaflet-popup-tip {
      background: rgba(5,12,24,.94);
      color: #e2e8f0;
    }
    .language-option {
      display:block; width:100%; text-align:left; padding:8px 10px;
      border-radius:8px; color:#cbd5e1; font-size:12px;
    }
    .language-option:hover { background:rgba(16,185,129,.12); color:#fff; }
    #return-banner {
      position:absolute; left:50%; transform:translateX(-50%);
      bottom:calc(4.5rem + env(safe-area-inset-bottom)); z-index:40; max-width:92vw;
      background:rgba(5,12,24,.95); border:1px solid rgba(52,211,153,.4);
      color:#e2e8f0; border-radius:14px; padding:12px 18px;
      font-size:13px; box-shadow:0 18px 50px rgba(0,0,0,.5);
      display:flex; align-items:center; gap:10px;
    }
    #return-banner .spinner {
      width:14px; height:14px; border-radius:50%; flex:none;
      border:2px solid rgba(52,211,153,.3); border-top-color:#34d399;
      animation:spin 1s linear infinite;
    }
    @keyframes spin { to { transform:rotate(360deg); } }
    #return-banner a { color:#6ee7b7; font-weight:700; }

    html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    body { -webkit-tap-highlight-color: transparent; overscroll-behavior: none; touch-action: manipulation; }
    header { padding-top: env(safe-area-inset-top); }
    footer#coords-footer { bottom: calc(0.5rem + env(safe-area-inset-bottom)); }

    #side-panel { transition: opacity .2s ease; }
    #panel-mini-title { display: none; }
    @media (max-width: 767px) {
      #panel-hero { display: none; }
      #panel-mini-title { display: block; }
      #side-panel:not(.minimized) #panel-hero { display: block; }
      #side-panel:not(.minimized) #panel-mini-title { display: none; }
    }
    #panel-toggle {
      position:absolute; top:8px; right:8px; z-index:10; pointer-events:auto;
      display:flex; align-items:center; justify-content:center;
      width:30px; height:30px; border-radius:9999px;
      background:rgba(2,6,23,.85); border:1px solid #1f2937; color:#94a3b8;
    }
    #panel-toggle:hover { color:#fff; border-color:rgba(52,211,153,.5); }

    @media (max-width: 767px) {
      .leaflet-bottom.leaflet-right { bottom: 60px; }
      #checkout-modal input, #checkout-modal textarea { font-size: 16px; }
    }
  </style>
</head>

<body class="bg-[#080d16] text-slate-100 font-sans h-screen overflow-hidden flex flex-col antialiased">

  <!-- HEADER -->
